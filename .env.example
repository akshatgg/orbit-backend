# ─── Environment ────────────────────────────────────────────────────────────
ENVIRONMENT=local
APP_TIMEZONE=Europe/London

# ─── Database ───────────────────────────────────────────────────────────────
# Any PostgreSQL 15+. Orbit's Supabase project works unchanged, or point this at
# a local/Cloud SQL database and run `alembic upgrade head`.
DATABASE_URL=postgresql://orbit:orbit@localhost:5433/orbit

# ─── Auth ───────────────────────────────────────────────────────────────────
# HS256 secret for Orbit's own session tokens.
JWT_SECRET=orbit-backend-dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720
# Public URLs: the backend builds Google's redirect URI from BACKEND_URL and
# sends users back to FRONTEND_URL after OAuth or a magic link.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8090
# Cookie name used by the Next frontend for the session.
SESSION_COOKIE=orbit_session

# ─── Google OAuth (authorization-code flow) ─────────────────────────────────
# Blank = "Continue with Google" returns 503 and the frontend hides the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Blank = magic-link bodies are logged instead of sent, so local dev needs none.
RESEND_API_KEY=
EMAIL_FROM="Orbit <hello@orbit.example>"

# ─── Stripe Connect (organiser payouts) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret of the Connect endpoint (account.updated). Optional.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Orbit's cut of each paid ticket, in percent. Blank or 0 = no fee.
PLATFORM_FEE_PERCENT=0
CURRENCY=GBP

# ─── Cloudinary (image uploads; falls back to local disk when blank) ────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=./var/uploads

# ─── Web push ───────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@orbit.example

# ─── Cron ───────────────────────────────────────────────────────────────────
# Sent as `Authorization: Bearer <CRON_SECRET>` by the scheduler.
CRON_SECRET=orbit-backend-dev-cron-secret-change-me

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── API metadata ───────────────────────────────────────────────────────────
API_PREFIX=/api
PROJECT_NAME=Orbit-Backend
VERSION=0.1.0
