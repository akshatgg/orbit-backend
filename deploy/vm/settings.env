# Non-secret settings shared by every markai-orbit host. bin/render-env joins
# this with the host's /etc/markai-orbit/site.env and the Secret Manager values
# into /etc/markai-orbit/orbit.env. Never put a secret here: the repo is public.
ENVIRONMENT=production
APP_TIMEZONE=Europe/London
# Caddy reaches uvicorn over the compose network, not from 127.0.0.1.
FORWARDED_ALLOW_IPS=*
# First boot of an empty database loads seeds/prod.sql; later boots skip it.
SEED_ON_EMPTY=1
UPLOAD_DIR=./var/uploads
